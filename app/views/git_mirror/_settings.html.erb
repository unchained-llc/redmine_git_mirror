<fieldset class="box tabular">
  <legend><%= l(:git_mirror_connections) %></legend>
  <% RedmineGitMirror::Settings::PROVIDERS.each do |provider| %>
    <% label = provider == 'github' ? 'GitHub' : 'GitLab' %>
    <p>
      <label><%= label %></label>
      <strong><%= l(RedmineGitMirror::Settings.connected?(provider) ? :git_mirror_connected : :git_mirror_disconnected) %></strong>
      <% if RedmineGitMirror::Oauth.configured?(provider) %>
        <%= link_to l(:git_mirror_connect, provider: label), git_mirror_authorize_path(provider: provider), method: :post, class: 'button' %>
      <% end %>
      <% if RedmineGitMirror::Settings.connected?(provider) %>
        <%= link_to l(:git_mirror_disconnect), git_mirror_disconnect_path(provider: provider), method: :post, class: 'button' %>
      <% end %>
    </p>
  <% end %>
  <p><%= label_tag 'settings_gitlab_url', 'GitLab URL' %>
    <%= text_field_tag 'settings[gitlab_url]', RedmineGitMirror::Settings[:gitlab_url], size: 60, id: 'settings_gitlab_url', placeholder: 'https://gitlab.example.com' %></p>
  <details class="git-mirror-token-settings">
    <summary><%= l(:git_mirror_use_pat) %></summary>
    <% RedmineGitMirror::Settings::PROVIDERS.each do |provider| %>
      <p><%= label_tag "settings_#{provider}_api_token", "#{provider == 'github' ? 'GitHub' : 'GitLab'} token" %>
        <%= password_field_tag "settings[#{provider}_api_token]", nil, size: 60, id: "settings_#{provider}_api_token", autocomplete: 'new-password', placeholder: RedmineGitMirror::Settings["#{provider}_api_token"].to_s.empty? ? nil : '••••••••' %>
        <em class="info"><%= l(provider == 'github' ? :git_mirror_github_permissions : :git_mirror_gitlab_permissions) %></em></p>
    <% end %>
    <p><%= l(:git_mirror_keep_token) %></p>
  </details>
  <p class="info"><%= l(:git_mirror_oauth_setup_note) %></p>
</fieldset>
<fieldset class="box tabular">
  <legend><%= l(:git_mirror_storage) %></legend>
  <p><%= label_tag 'settings_custom_path', 'Repositories Path' %>
    <%= text_field_tag 'settings[custom_path]', RedmineGitMirror::Settings[:custom_path], id: 'settings_custom_path', size: 80, placeholder: RedmineGitMirror::Settings.default_path %>
    <em class="info"><%= l(:git_mirror_storage_note) %></em></p>
</fieldset>
